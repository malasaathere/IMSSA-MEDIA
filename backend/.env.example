# Backend Environment Variables
# Copy this file to .env and fill in your values

# Supabase
SUPABASE_URL=https://nkcqyetgnxgygrxigvym.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Frontend URL (for CORS and email redirect links)
FRONTEND_URL=https://imssa-media.vercel.app

# Gmail SMTP (for password reset emails)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Google Drive OAuth (for file uploads)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Server
PORT=4000
